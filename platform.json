{
  "name": "community",
  "source_repo": "aomi-labs/community-apps",
  "publish_branch": "publish",
  "app_path_prefix": "apps",
  "app_path_convention": "apps/{installation_id}/{app_slug}",
  "release_tag_convention": "apps-{installation_id}-{app_slug}-{short_commit}",
  "deployment_manifest": ".aomi/deployment.json",
  "visibility": "public",
  "review_policy": "community-review",
  "required_sdk_version": "3.0.0",
  "default_target": "x86_64-unknown-linux-gnu"
}
